{
  "name": "vue-sfc-styles-demo",
  "main": "app/app.ts",
  "version": "1.0.0",
  "license": "MIT-0",
  "private": true,
  "scripts": {
    "packages:setup": "node scripts/setup-packages.mjs",
    "local:build": "cd ../ns-css-improvements/integration/NativeScript && npx nx run-many -t build -p core,vite,webpack5 && cd ../nativescript-vue && npm run build",
    "local:install": "node scripts/install-local-packages.mjs",
    "local:update": "npm run local:build && npm run local:install",
    "android:vite": "ns run android",
    "android:vite:bundle": "ns run android --no-hmr",
    "android:webpack": "ns run android --config nativescript.webpack.config",
    "android:webpack:bundle": "ns run android --no-hmr --config nativescript.webpack.config",
    "ios:vite": "ns run ios",
    "ios:vite:bundle": "ns run ios --no-hmr",
    "ios:webpack": "ns run ios --config nativescript.webpack.config",
    "ios:webpack:bundle": "ns run ios --no-hmr --config nativescript.webpack.config",
    "test": "node --test 'app/components/sfc-style-tests/*.test.mjs'"
  },
  "dependencies": {
    "@nativescript/core": "file:../ns-css-improvements/integration/NativeScript/dist/packages/core",
    "@valor/nativescript-websockets": "^2.0.3",
    "nativescript-vue": "file:../ns-css-improvements/integration/nativescript-vue"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/tailwind": "file:../ns-css-improvements/integration/tailwind",
    "@nativescript/types": "~9.0.0",
    "@nativescript/vite": "file:../ns-css-improvements/integration/NativeScript/dist/packages/vite",
    "@nativescript/webpack": "file:../ns-css-improvements/integration/NativeScript/dist/packages/webpack5",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@nativescript/core": "$@nativescript/core"
  }
}
