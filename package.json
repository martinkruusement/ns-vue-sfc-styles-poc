{
  "name": "vue-sfc-styles-demo",
  "main": "app/app.ts",
  "version": "1.0.0",
  "license": "MIT-0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/packages.mjs postinstall",
    "packages": "node scripts/packages.mjs status",
    "packages:patched": "node scripts/packages.mjs patched",
    "packages:published": "node scripts/packages.mjs published",
    "packages:local": "node scripts/packages.mjs local",
    "patches:generate": "node scripts/generate-patches.mjs",
    "android:vite": "ns run android",
    "android:vite:bundle": "ns run android --no-hmr",
    "android:webpack": "ns run android --config nativescript.webpack.config",
    "android:webpack:bundle": "ns run android --no-hmr --config nativescript.webpack.config",
    "ios:vite": "ns run ios",
    "ios:vite:bundle": "ns run ios --no-hmr",
    "ios:webpack": "ns run ios --config nativescript.webpack.config",
    "ios:webpack:bundle": "ns run ios --no-hmr --config nativescript.webpack.config",
    "test": "node --test 'app/components/sfc-style-tests/*.test.mjs'"
  },
  "dependencies": {
    "@nativescript/core": "9.1.3",
    "@valor/nativescript-websockets": "^2.0.3",
    "nativescript-vue": "3.1.2"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/tailwind": "4.1.0",
    "@nativescript/types": "~9.0.0",
    "@nativescript/vite": "8.0.21",
    "@nativescript/webpack": "5.0.39",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@nativescript/core": "$@nativescript/core"
  }
}
